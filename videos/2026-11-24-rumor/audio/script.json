  {
   "id": "hook",
   "text": "One person hears a rumor. Every minute, everyone who knows it tells one new person. How long until the whole world knows?",
   "gap": 0.5
  },
  {
   "id": "m05",
   "text": "Five minutes: your whole classroom.",
   "gap": 0.5
  },
  {
   "id": "m10",
   "text": "Ten: your entire school.",
   "gap": 0.5
  },
  {
   "id": "m13",
   "text": "Thirteen: a small town.",
   "gap": 0.5
  },
  {
   "id": "m16",
   "text": "Sixteen: a packed stadium.",
   "gap": 0.5
  },
  {
   "id": "m20",
